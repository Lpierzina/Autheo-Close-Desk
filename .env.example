# Autheo Close Desk - environment variables.
# Copy to .env.local for local development. Never commit real values.
# In Shadw.cloud, set these under Settings -> Environment Variables instead of using a file.

# --- Database (required) -------------------------------------------------------------
# PostgreSQL 14 or newer. Tested on PostgreSQL 16.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Optional. Leave unset to follow the sslmode in DATABASE_URL.
#   require    TLS with certificate verification
#   no-verify  TLS without certificate verification (only if the provider's CA cannot be verified)
#   disable    no TLS (local development only)
# DATABASE_SSL=require

# Optional. Connections per app instance. Default 5.
# DATABASE_POOL_MAX=5

# --- Authentication: Clerk (required in production) ----------------------------------
# Without both keys the app serves 503 on every page and API route.
# The publishable key must be available at build time and at runtime.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME

# --- Application URL (required for invitation emails) ---------------------------------
# Public origin of the deployment, no trailing slash. Invitation links return to
# ${APP_BASE_URL}/accept-invitation.
APP_BASE_URL=https://close-desk.example.com

# --- Local development only -----------------------------------------------------------
# Replaces Clerk with a local user picker at /dev/sign-in. It is ignored unless
# NODE_ENV is not "production"; setting it in production closes the app (503).
# Never set these in Shadw.cloud.
# CLOSE_DESK_DEV_AUTH=1
# CLOSE_DESK_DEV_AUTH_SECRET=any-long-random-string

# --- Tests only -----------------------------------------------------------------------
# The database name must contain "test". Tests truncate every table in it.
# TEST_DATABASE_URL=postgres://closedesk:closedesk@127.0.0.1:5432/closedesk_test
