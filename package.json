{
  "name": "autheo-close-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Autheo Close Desk: a browser-only reconciliation of subscriptions, cleared funding and approved allocations that produces a reviewed ownership register export.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scale": "SCALE=1 vitest run tests/perf --disable-console-intercept",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "assets:brand": "node scripts/build-brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "vitest": "^5.1.1"
  }
}
