{
  "name": "autheo-close-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Autheo Close Desk — reconciles subscriptions, funding and approved allocations for one offering and produces a reviewed ownership register.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "user:invite": "tsx --conditions=react-server scripts/invite-user.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.31.0",
    "@clerk/nextjs": "^7.10.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "vitest": "^5.1.1"
  }
}
